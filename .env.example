# Read-only network configuration; ownership never depends on these endpoints.
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_MAINNET_RPC_URL=https://mainnet.base.org
PUBLIC_BUNDLER_RPC_URL=https://public.pimlico.io/v2/84532/rpc
LOCAL_RPC_URL=http://127.0.0.1:8545
WALLET_LAB_PORT=4173
# Browser checks use Playwright's managed Chromium unless overridden.
# BROWSER_EXECUTABLE_PATH=/absolute/path/to/chromium
# REFERENCE_APP_URL=http://127.0.0.1:4174
# WALLET_LAB_URL=http://127.0.0.1:4173
# Submitter scripts read a dotenv file locally; never paste a key into CLI args.
# SUBMITTER_KEY_FILE=/absolute/path/to/testnet-submitter.env
# SUBMITTER_KEY_VARIABLE=SUBMITTER_PRIVATE_KEY
